// SPM `.systemLibrary` target's module map. Module name MUST match
// `ffi_module_name` in cera-ffi/uniffi.toml, because the generated
// `cera_ffi.swift` guards its import with `#if canImport(CeraFFI)`.
// Any other name and the guard fails SILENTLY, leaving every
// `uniffi_cera_ffi_fn_*` symbol undeclared in scope at compile time
// rather than producing a "no such module" error that names the cause.
//
// The header itself is a symlink into `cera-ffi/bindings/swift/` so
// `just bindings` regenerations are picked up automatically. Renaming
// the module there breaks that symlink too, which at least fails
// loudly.
module CeraFFI {
    header "CeraFFI.h"
    export *
    // Match the `use` lines that the canonical
    // `cera-ffi/bindings/swift/CeraFFI.modulemap` declares, in case a
    // future Linux Swift leg or a non-default toolchain depends on the
    // explicit platform-module imports for the C stdint / stdbool /
    // Darwin types referenced by the generated header.
    use "Darwin"
    use "_Builtin_stdbool"
    use "_Builtin_stdint"
}
