-            if path.is_absolute() {
-                path
-            } else {
-                repo_root().join(path)
-            }
-        }
-        Err(_) => {
-            println!("SKIPPED: UBDG_RECORD_ENUM_METHODS_LIB not set");
-            return;
-        }
