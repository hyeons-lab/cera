From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: cera <cera@local>
Date: Tue, 11 Aug 2026 14:25:30 -0700
Subject: build: flatten to a standalone crate outside the parent workspace
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Vendored into cera as third_party/uniffi-bindgen-dart. The crate is lifted out
of the upstream workspace (crates/ubdg_bindgen) and given its own [workspace]
table, so `cargo run --manifest-path third_party/…` builds it independently
instead of joining cera's workspace and its lockfile.

Upstream's `tests/golden_generated.rs` is dropped with the workspace: it golden-
compares against fixtures that live in the workspace root, which does not come
along. The vendored generator is exercised by cera's own `just dart-bindings-check`
instead, which regenerates the committed bindings and fails on any diff.
---
 .gitignore                |   1 +
 Cargo.toml                |  39 ++--
 LICENSE                   |  21 +++
 tests/golden_generated.rs | 367 --------------------------------------
 4 files changed, 45 insertions(+), 383 deletions(-)
 create mode 100644 .gitignore
 create mode 100644 LICENSE
 delete mode 100644 tests/golden_generated.rs

diff --git a/.gitignore b/.gitignore
new file mode 100644
index 0000000..ea8c4bf
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1 @@
+/target
diff --git a/Cargo.toml b/Cargo.toml
index 420ac65..bb9b59d 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,14 +1,21 @@
+# Vendored from https://github.com/nchapman/uniffi-bindgen-dart @ v0.1.3
+# (crate `ubdg_bindgen`, the `uniffi-bindgen-dart` binary), flattened to a
+# standalone crate. Local modifications: callback-interface argument lowering
+# + Option<primitive> support for streaming (see src/dart/callback.rs). These
+# fixes are to be upstreamed; this vendored copy is the interim source.
+#
+# Its own `[workspace]` table keeps it OUT of the parent cera workspace so
+# `cargo run --manifest-path …` builds it independently.
+[workspace]
+
 [package]
 name = "uniffi-bindgen-dart"
-description = "Dart bindings generator for UniFFI"
-version.workspace = true
-edition.workspace = true
-license.workspace = true
-authors.workspace = true
-repository.workspace = true
-keywords.workspace = true
-categories.workspace = true
-readme = "../../README.md"
+description = "Dart bindings generator for UniFFI (vendored + patched for Cera)"
+version = "0.1.3"
+edition = "2021"
+license = "MIT"
+authors = ["Nick Chapman <nchapman@fastmail.com>"]
+repository = "https://github.com/nchapman/uniffi-bindgen-dart"
 
 [lib]
 name = "uniffi_bindgen_dart"
@@ -18,12 +25,12 @@ name = "uniffi-bindgen-dart"
 path = "src/main.rs"
 
 [dependencies]
-anyhow.workspace = true
-camino.workspace = true
-clap.workspace = true
-serde.workspace = true
-toml.workspace = true
-uniffi_bindgen.workspace = true
+anyhow = "1.0.98"
+camino = "1.1.9"
+clap = { version = "4.5.32", features = ["derive"] }
+serde = { version = "1.0.219", features = ["derive"] }
+toml = "0.8.20"
+uniffi_bindgen = "0.31.0"
 
 [dev-dependencies]
-tempfile.workspace = true
+tempfile = "3.19.0"
