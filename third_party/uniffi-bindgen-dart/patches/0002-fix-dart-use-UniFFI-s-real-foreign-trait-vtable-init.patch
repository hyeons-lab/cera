From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: cera <cera@local>
Date: Tue, 11 Aug 2026 14:25:31 -0700
Subject: fix(dart): use UniFFI's real foreign-trait vtable init symbol

The generator emitted `<name>_trait_callback_init`, which UniFFI does not
export, so registering a Dart-implemented trait failed at dlsym with no
diagnostic beyond a missing symbol.

UniFFI's actual export is `uniffi_<namespace>_fn_init_callback_vtable_<name>`
with the name lowercased and no separators, so the namespace has to be threaded
into the symbol builder.
---
 src/dart/callback.rs                   |  4 ++--
 src/dart/render_bound_methods/setup.rs |  2 +-
 src/dart/render_objects.rs             | 12 ++++++++++--
 3 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/src/dart/callback.rs b/src/dart/callback.rs
index f6acf2a..aceb792 100644
--- a/src/dart/callback.rs
+++ b/src/dart/callback.rs
@@ -1066,8 +1066,8 @@ mod tests {
     #[test]
     fn trait_init_symbol() {
         assert_eq!(
-            trait_callback_init_symbol("MyService"),
-            "myservice_trait_callback_init"
+            trait_callback_init_symbol("demo", "MyService"),
+            "uniffi_demo_fn_init_callback_vtable_myservice"
         );
     }
 
diff --git a/src/dart/render_bound_methods/setup.rs b/src/dart/render_bound_methods/setup.rs
index fe608aa..31c368a 100644
--- a/src/dart/render_bound_methods/setup.rs
+++ b/src/dart/render_bound_methods/setup.rs
@@ -304,7 +304,7 @@ pub(super) fn render_ffi_lookup_fields(
         let init_done_field = trait_callback_init_done_field_name(&trait_object.name);
         let vtable_field = trait_callback_vtable_field_name(&trait_object.name);
         let bridge_name = trait_callback_bridge_class_name(&trait_object.name);
-        let init_symbol = trait_callback_init_symbol(&trait_object.name);
+        let init_symbol = trait_callback_init_symbol(ffi_namespace, &trait_object.name);
         out.push('\n');
         out.push_str(&format!(
             "  late final void Function(ffi.Pointer<{vtable_name}>) {init_field} = _lib.lookupFunction<ffi.Void Function(ffi.Pointer<{vtable_name}>), void Function(ffi.Pointer<{vtable_name}>)>('{init_symbol}');\n"
diff --git a/src/dart/render_objects.rs b/src/dart/render_objects.rs
index 8158a58..d42393d 100644
--- a/src/dart/render_objects.rs
+++ b/src/dart/render_objects.rs
@@ -910,8 +910,16 @@ pub(super) fn trait_callback_vtable_struct_name(object_name: &str) -> String {
     format!("_{}TraitVTable", to_upper_camel(object_name))
 }
 
-pub(super) fn trait_callback_init_symbol(object_name: &str) -> String {
-    format!("{}_trait_callback_init", object_name.to_ascii_lowercase())
+pub(super) fn trait_callback_init_symbol(ffi_namespace: &str, object_name: &str) -> String {
+    // UniFFI exports the foreign-trait vtable initializer as
+    // `uniffi_<namespace>_fn_init_callback_vtable_<name>` (name lowercased, no
+    // separators). The previous `<name>_trait_callback_init` form matched no
+    // exported symbol, so registering a Dart-implemented trait failed `dlsym`.
+    format!(
+        "uniffi_{}_fn_init_callback_vtable_{}",
+        ffi_namespace,
+        object_name.to_ascii_lowercase()
+    )
 }
 
 pub(super) fn trait_callback_init_field_name(object_name: &str) -> String {
