                                      half(src_bf[min(t0 + 2u, last) * P.k + kidx]),
                                      half(src_bf[min(t0 + 3u, last) * P.k + kidx]));
        }
        GroupMemoryBarrierWithGroupSync();
        uint pdg = gate_d[kb * P.m + rrow];
        uint pdu = up_d[kb * P.m + rrow];
