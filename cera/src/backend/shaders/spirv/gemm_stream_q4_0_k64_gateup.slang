                g3 += b3 * wg;
                g4 += b4 * wg;
                g5 += b5 * wg;
                g6 += b6 * wg;
                g7 += b7 * wg;
                half wu = (half((ulo >> 12u) & 0xFu) - half(8.0h)) * dwu;
                u0 += b0 * wu;
                u1 += b1 * wu;
                u2 += b2 * wu;
                u3 += b3 * wu;
