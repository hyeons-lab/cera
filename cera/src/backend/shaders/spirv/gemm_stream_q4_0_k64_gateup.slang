            uint e = s * 128u + lid;
            uint kk = e % 64u;
            uint g = e / 64u;
            uint t0 = col_base + g * 4u;
            uint kidx = kb * 64u + kk;
            uint last = P.n_valid - 1u;
            sh_b[kk * 8u + g] = half4(half(src_bf[min(t0, last) * P.k + kidx]),
