            if (c7 + 1u < P.n_valid) { dst[(c7 + 1u) * P.y_stride + row1] = f.y; }
            if (c7 + 2u < P.n_valid) { dst[(c7 + 2u) * P.y_stride + row1] = f.z; }
            if (c7 + 3u < P.n_valid) { dst[(c7 + 3u) * P.y_stride + row1] = f.w; }
        }
    }
}
