// Causal (and bidirectional-prefix) flash attention prefill for head_dim 64 with fp16 math, 64 queries per
// workgroup, reading the packed-f16 KV cache. GENERATED by scripts/attn-fp16/gen.py --production; edit the
// generator, not this file.
//
// The fp16 twin of `attention_prefill_hd64.wgsl` with the same 14-word parameter block and bindings
// (q f32, K and V packed f16 words, out f32), the same windows (causal with `start_pos`, bidirectional with a
// media prefix, `q_base` / `n_sub` dispatch splitting, an empty window writes zeros), and a different grid:
// (ceil(n_sub / 64), n_heads) workgroups of 256 threads. Q (pre-scaled by scale * log2(e)), K^T, V and the
// probabilities are half in shared memory, QK^T and PV are accumulated in half and widened into f32 every
// 8 dims / 4 keys, and the softmax statistics and the output accumulator are f32. Against an f64 reference the
// output error is 0.06 to 0.25% of the output rms (more with larger logits); 64 queries share each K/V tile
// load and barrier, which is what makes it 1.7x faster than the f32 kernel on an Adreno 830. The 32 KiB of
// workgroup memory is why it is fp16 only.
// Generated by scripts/attn-fp16/gen.py (S_BLOCK=8, PV_BLOCK=4); do not edit by hand.
[[vk::binding(0, 0)]] StructuredBuffer<float4> q_batch;
[[vk::binding(1, 0)]] StructuredBuffer<uint2> k_cache;   // packed f16, 4 dims per element
[[vk::binding(2, 0)]] StructuredBuffer<uint2> v_cache;
[[vk::binding(3, 0)]] RWStructuredBuffer<float4> out_batch;
[[vk::binding(4, 0)]] StructuredBuffer<uint> params;

static const float LOG2E = 1.4426950408889634;
static const float NEG = -1.0e30;

groupshared half4 qs[1024];
groupshared half2 kt[1024];    // K^T: [d][16 key pairs]
groupshared half4 vs[544];     // V: [32 keys][17] (one of padding)
groupshared float ps[2048];
groupshared half4 ph[512];
groupshared float pm[256];
groupshared float corr[64];
groupshared float lsum[256];

uint key_window(uint pos, uint bidir, uint prefix, uint total, uint max_seq) {
    uint w = pos + 1u;
    if (bidir != 0u) { w = pos < prefix ? prefix : total; }
    return min(w, max_seq);
}

half4 half4_of(uint2 w) { return reinterpret<half4>(w); }

[numthreads(256, 1, 1)]
void main(uint3 wid : SV_GroupID, uint t : SV_GroupThreadID) {
    uint tx = t % 16u;
    uint ty = t / 16u;
    uint n_head = params[0];
    uint n_kv = params[1];
    uint kv_dim4 = params[3] / 4u;
    uint max_seq = params[4];
    float scale = asfloat(params[5]);
    uint start_pos = params[6];
    uint total = params[7];
    uint q_stride4 = params[8] / 4u;
    uint out_stride4 = params[9] / 4u;
    uint q_base = params[10];
    uint n_sub = params[11];
    uint bidir = params[12];
    uint prefix = params[13];
    uint head = wid.y;
    uint kv_head = head / (n_head / n_kv);
    uint q0 = wid.x * 64u;
    uint last_row = min(q0 + 63u, n_sub - 1u);
    uint wg_limit = key_window(start_pos + q_base + last_row, bidir, prefix, total, max_seq);

    {
        uint qg = t % 16u;
        uint dv = t / 16u;
        float s = scale * LOG2E;
        float4 r0 = q_batch[(q_base + min(q0 + qg * 4u + 0u, n_sub - 1u)) * q_stride4 + head * 16u + dv] * s;
        float4 r1 = q_batch[(q_base + min(q0 + qg * 4u + 1u, n_sub - 1u)) * q_stride4 + head * 16u + dv] * s;
        float4 r2 = q_batch[(q_base + min(q0 + qg * 4u + 2u, n_sub - 1u)) * q_stride4 + head * 16u + dv] * s;
        float4 r3 = q_batch[(q_base + min(q0 + qg * 4u + 3u, n_sub - 1u)) * q_stride4 + head * 16u + dv] * s;
        qs[(4u * dv + 0u) * 16u + qg] = half4(half(r0.x), half(r1.x), half(r2.x), half(r3.x));
        qs[(4u * dv + 1u) * 16u + qg] = half4(half(r0.y), half(r1.y), half(r2.y), half(r3.y));
        qs[(4u * dv + 2u) * 16u + qg] = half4(half(r0.z), half(r1.z), half(r2.z), half(r3.z));
        qs[(4u * dv + 3u) * 16u + qg] = half4(half(r0.w), half(r1.w), half(r2.w), half(r3.w));
    }
    uint lim0 = key_window(start_pos + q_base + min(q0 + ty * 4u + 0u, n_sub - 1u), bidir, prefix, total, max_seq);
    uint lim1 = key_window(start_pos + q_base + min(q0 + ty * 4u + 1u, n_sub - 1u), bidir, prefix, total, max_seq);
    uint lim2 = key_window(start_pos + q_base + min(q0 + ty * 4u + 2u, n_sub - 1u), bidir, prefix, total, max_seq);
    uint lim3 = key_window(start_pos + q_base + min(q0 + ty * 4u + 3u, n_sub - 1u), bidir, prefix, total, max_seq);

    float4 o0 = float4(0.0); float4 o1 = float4(0.0); float4 o2 = float4(0.0); float4 o3 = float4(0.0);
    uint sq = t % 64u;
    uint sp = t / 64u;
    float m = NEG;
    float l = 0.0;

    for (uint kb = 0u; kb < wg_limit; kb += 32u) {

        {
            uint u = t + 256u * 0u;
            uint kp = u % 16u;
            uint dv = u / 16u;
            uint ra = kb + kp * 2u;
            half4 a = half4(0.0h);
            half4 b = half4(0.0h);
            if (ra < wg_limit) { a = half4_of(k_cache[ra * kv_dim4 + kv_head * 16u + dv]); }
            if (ra + 1u < wg_limit) { b = half4_of(k_cache[(ra + 1u) * kv_dim4 + kv_head * 16u + dv]); }
            kt[(4u * dv + 0u) * 16u + kp] = half2(a.x, b.x);
            kt[(4u * dv + 1u) * 16u + kp] = half2(a.y, b.y);
            kt[(4u * dv + 2u) * 16u + kp] = half2(a.z, b.z);
            kt[(4u * dv + 3u) * 16u + kp] = half2(a.w, b.w);
        }
        GroupMemoryBarrierWithGroupSync();

        float2 sf0 = float2(0.0); float2 sf1 = float2(0.0); float2 sf2 = float2(0.0); float2 sf3 = float2(0.0);
        [loop] for (uint db = 0u; db < 64u; db += 8u) {
            half2 s0 = half2(0.0h); half2 s1 = half2(0.0h); half2 s2 = half2(0.0h); half2 s3 = half2(0.0h);
            {
                half4 qv = qs[(db + 0u) * 16u + ty];
                half2 kv = kt[(db + 0u) * 16u + tx];
                s0 += qv.x * kv; s1 += qv.y * kv; s2 += qv.z * kv; s3 += qv.w * kv;
            }
            {
                half4 qv = qs[(db + 1u) * 16u + ty];
                half2 kv = kt[(db + 1u) * 16u + tx];
                s0 += qv.x * kv; s1 += qv.y * kv; s2 += qv.z * kv; s3 += qv.w * kv;
            }
            {
                half4 qv = qs[(db + 2u) * 16u + ty];
                half2 kv = kt[(db + 2u) * 16u + tx];
                s0 += qv.x * kv; s1 += qv.y * kv; s2 += qv.z * kv; s3 += qv.w * kv;
            }
            {
                half4 qv = qs[(db + 3u) * 16u + ty];
                half2 kv = kt[(db + 3u) * 16u + tx];
                s0 += qv.x * kv; s1 += qv.y * kv; s2 += qv.z * kv; s3 += qv.w * kv;
            }
            {
                half4 qv = qs[(db + 4u) * 16u + ty];
                half2 kv = kt[(db + 4u) * 16u + tx];
                s0 += qv.x * kv; s1 += qv.y * kv; s2 += qv.z * kv; s3 += qv.w * kv;
            }
            {
                half4 qv = qs[(db + 5u) * 16u + ty];
                half2 kv = kt[(db + 5u) * 16u + tx];
                s0 += qv.x * kv; s1 += qv.y * kv; s2 += qv.z * kv; s3 += qv.w * kv;
            }
            {
                half4 qv = qs[(db + 6u) * 16u + ty];
                half2 kv = kt[(db + 6u) * 16u + tx];
                s0 += qv.x * kv; s1 += qv.y * kv; s2 += qv.z * kv; s3 += qv.w * kv;
            }
            {
                half4 qv = qs[(db + 7u) * 16u + ty];
                half2 kv = kt[(db + 7u) * 16u + tx];
                s0 += qv.x * kv; s1 += qv.y * kv; s2 += qv.z * kv; s3 += qv.w * kv;
            }
            sf0 += float2(s0); sf1 += float2(s1); sf2 += float2(s2); sf3 += float2(s3);
        }
        uint key0 = kb + tx * 2u;
        uint pb0 = (tx * 2u + 0u) * 64u + ty * 4u;
        uint pb1 = (tx * 2u + 1u) * 64u + ty * 4u;
        ps[pb0] = key0 < lim0 ? sf0.x : NEG;
        ps[pb0 + 1u] = key0 < lim1 ? sf1.x : NEG;
        ps[pb0 + 2u] = key0 < lim2 ? sf2.x : NEG;
        ps[pb0 + 3u] = key0 < lim3 ? sf3.x : NEG;
        ps[pb1] = key0 + 1u < lim0 ? sf0.y : NEG;
        ps[pb1 + 1u] = key0 + 1u < lim1 ? sf1.y : NEG;
        ps[pb1 + 2u] = key0 + 1u < lim2 ? sf2.y : NEG;
        ps[pb1 + 3u] = key0 + 1u < lim3 ? sf3.y : NEG;
        GroupMemoryBarrierWithGroupSync();

        {
            uint idx = t + 256u * 0u;
            uint kj = idx / 16u;
            uint dv = idx % 16u;
            uint row = kb + kj;
            half4 x = half4(0.0h);
            if (row < wg_limit) { x = half4_of(v_cache[row * kv_dim4 + kv_head * 16u + dv]); }
            vs[kj * 17u + dv] = x;
        }
        {
            uint idx = t + 256u * 1u;
            uint kj = idx / 16u;
            uint dv = idx % 16u;
            uint row = kb + kj;
            half4 x = half4(0.0h);
            if (row < wg_limit) { x = half4_of(v_cache[row * kv_dim4 + kv_head * 16u + dv]); }
            vs[kj * 17u + dv] = x;
        }
        float pmax = NEG;
        float x0 = ps[(sp * 8u + 0u) * 64u + sq]; pmax = max(pmax, x0);
        float x1 = ps[(sp * 8u + 1u) * 64u + sq]; pmax = max(pmax, x1);
        float x2 = ps[(sp * 8u + 2u) * 64u + sq]; pmax = max(pmax, x2);
        float x3 = ps[(sp * 8u + 3u) * 64u + sq]; pmax = max(pmax, x3);
        float x4 = ps[(sp * 8u + 4u) * 64u + sq]; pmax = max(pmax, x4);
        float x5 = ps[(sp * 8u + 5u) * 64u + sq]; pmax = max(pmax, x5);
        float x6 = ps[(sp * 8u + 6u) * 64u + sq]; pmax = max(pmax, x6);
        float x7 = ps[(sp * 8u + 7u) * 64u + sq]; pmax = max(pmax, x7);
        pm[sp * 64u + sq] = pmax;
        GroupMemoryBarrierWithGroupSync();
        float m_new = max(max(m, max(pm[sq], pm[64u + sq])), max(pm[128u + sq], pm[192u + sq]));
        float c = exp2(m - m_new);
        float psum = 0.0;
        float p0 = exp2(x0 - m_new); psum += p0;
        float p1 = exp2(x1 - m_new); psum += p1;
        float p2 = exp2(x2 - m_new); psum += p2;
        float p3 = exp2(x3 - m_new); psum += p3;
        float p4 = exp2(x4 - m_new); psum += p4;
        float p5 = exp2(x5 - m_new); psum += p5;
        float p6 = exp2(x6 - m_new); psum += p6;
        float p7 = exp2(x7 - m_new); psum += p7;
        ps[(sp * 8u + 0u) * 64u + sq] = p0;
        ps[(sp * 8u + 1u) * 64u + sq] = p1;
        ps[(sp * 8u + 2u) * 64u + sq] = p2;
        ps[(sp * 8u + 3u) * 64u + sq] = p3;
        ps[(sp * 8u + 4u) * 64u + sq] = p4;
        ps[(sp * 8u + 5u) * 64u + sq] = p5;
        ps[(sp * 8u + 6u) * 64u + sq] = p6;
        ps[(sp * 8u + 7u) * 64u + sq] = p7;
        l = l * c + psum;
        m = m_new;
        if (sp == 0u) { corr[sq] = c; }
        GroupMemoryBarrierWithGroupSync();
        for (uint z = 0u; z < 2u; z++) {
            uint e = t + 256u * z;
            uint key = e / 16u;
            uint qg = e % 16u;
            ph[e] = half4(half(ps[key * 64u + qg * 4u]), half(ps[key * 64u + qg * 4u + 1u]),
                          half(ps[key * 64u + qg * 4u + 2u]), half(ps[key * 64u + qg * 4u + 3u]));
        }
        GroupMemoryBarrierWithGroupSync();
        o0 *= corr[ty * 4u + 0u];
        o1 *= corr[ty * 4u + 1u];
        o2 *= corr[ty * 4u + 2u];
        o3 *= corr[ty * 4u + 3u];
        [loop] for (uint jb = 0u; jb < 32u; jb += 4u) {
            half4 a0 = half4(0.0h); half4 a1 = half4(0.0h); half4 a2 = half4(0.0h); half4 a3 = half4(0.0h);
            {
                half4 pv = ph[(jb + 0u) * 16u + ty];
                half4 vv = vs[(jb + 0u) * 17u + tx];
                a0 += pv.x * vv; a1 += pv.y * vv; a2 += pv.z * vv; a3 += pv.w * vv;
            }
            {
                half4 pv = ph[(jb + 1u) * 16u + ty];
                half4 vv = vs[(jb + 1u) * 17u + tx];
                a0 += pv.x * vv; a1 += pv.y * vv; a2 += pv.z * vv; a3 += pv.w * vv;
            }
            {
                half4 pv = ph[(jb + 2u) * 16u + ty];
                half4 vv = vs[(jb + 2u) * 17u + tx];
                a0 += pv.x * vv; a1 += pv.y * vv; a2 += pv.z * vv; a3 += pv.w * vv;
            }
            {
                half4 pv = ph[(jb + 3u) * 16u + ty];
                half4 vv = vs[(jb + 3u) * 17u + tx];
                a0 += pv.x * vv; a1 += pv.y * vv; a2 += pv.z * vv; a3 += pv.w * vv;
            }
            o0 += float4(a0); o1 += float4(a1); o2 += float4(a2); o3 += float4(a3);
        }
        GroupMemoryBarrierWithGroupSync();
    }

    lsum[sp * 64u + sq] = l;
    GroupMemoryBarrierWithGroupSync();
    uint r0 = q0 + ty * 4u;
    float s0 = lsum[ty * 4u] + lsum[64u + ty * 4u] + lsum[128u + ty * 4u] + lsum[192u + ty * 4u];
    float s1 = lsum[ty * 4u + 1u] + lsum[64u + ty * 4u + 1u] + lsum[128u + ty * 4u + 1u] + lsum[192u + ty * 4u + 1u];
    float s2 = lsum[ty * 4u + 2u] + lsum[64u + ty * 4u + 2u] + lsum[128u + ty * 4u + 2u] + lsum[192u + ty * 4u + 2u];
    float s3 = lsum[ty * 4u + 3u] + lsum[64u + ty * 4u + 3u] + lsum[128u + ty * 4u + 3u] + lsum[192u + ty * 4u + 3u];
    float i0 = s0 > 0.0 ? 1.0 / s0 : 0.0;
    float i1 = s1 > 0.0 ? 1.0 / s1 : 0.0;
    float i2 = s2 > 0.0 ? 1.0 / s2 : 0.0;
    float i3 = s3 > 0.0 ? 1.0 / s3 : 0.0;
    if (r0 + 0u < n_sub) { out_batch[(q_base + r0 + 0u) * out_stride4 + head * 16u + tx] = o0 * i0; }
    if (r0 + 1u < n_sub) { out_batch[(q_base + r0 + 1u) * out_stride4 + head * 16u + tx] = o1 * i1; }
    if (r0 + 2u < n_sub) { out_batch[(q_base + r0 + 2u) * out_stride4 + head * 16u + tx] = o2 * i2; }
    if (r0 + 3u < n_sub) { out_batch[(q_base + r0 + 3u) * out_stride4 + head * 16u + tx] = o3 * i3; }
}
