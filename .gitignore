# Rust
/target/
**/*.rs.bk
# Cargo.lock IS tracked. This workspace ships binaries (cera-cli) and an
# FFI library, and CI resolving dependencies fresh on every run made builds
# non-reproducible: any transitive crate publishing a broken release turned
# every branch red at once, unrelated to what changed.

# Gradle / Kotlin (cera-parity Kotlin leg + any future Gradle subprojects)
**/.gradle/
**/.kotlin/
**/build/
!**/src/**/build/

# Swift Package Manager (cera-parity Swift leg + any future SPM subprojects)
**/.build/
**/.swiftpm/
**/Package.resolved

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Claude Code local state (memory, skills, scheduled tasks, per-project settings)
.claude/

# Local-only development logs (per-branch session notes, plans)
devlog/

# wasm-pack build output (generated by the `wasm-*` justfile recipes)
cera-wasm/pkg-*/
cera-wasm/examples/**/pkg/

# Models
*.gguf
*.onnx
*.pt
models/
training/.venv/
training/checkpoints/
training/data/
training/**/__pycache__/

# Environment
.env

# Benchmark artifacts
benchmark_results.csv
benchmark_output.log
cera_time.txt
llama_time.txt
bench_results.csv
bench_log.txt
