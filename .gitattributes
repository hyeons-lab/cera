# Generated / vendored code — marked `linguist-generated` so GitHub collapses it
# in diffs, excludes it from language stats, and review tooling (Copilot, etc.)
# can skip it. None of these are hand-edited.

# UniFFI bindings — regenerated by `just bindings` from the cera-ffi Rust surface.
cera-ffi/bindings/** linguist-generated=true

# Vendored copy of the generated FFI header/modulemap for the parity Swift leg.
cera-parity/legs/swift/Sources/cera_ffiFFI/** linguist-generated=true

# flatbuffers-generated Rust (from the .fbs schema via flatc).
cera/src/generated/** linguist-generated=true

# Vendored Hexagon DSP skels (prebuilt binaries + upstream license).
cera/src/backend/hexagon/skels/** linguist-generated=true

# Vendored XRT headers, WSL kernel scripts, and prebuilt XDNA NPU kernel binaries.
cera/src/backend/xdna/shim/include/** linguist-generated=true
cera/src/backend/xdna/kernels/*.sh text eol=lf
tools/xdna-spike/*.sh text eol=lf
tools/xdna-spike/iron/*.sh text eol=lf
cera/src/backend/xdna/kernels/*.xclbin binary linguist-generated=true
cera/src/backend/xdna/kernels/*.bin binary linguist-generated=true
