<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The always-on audio service (AudioPipelineService): a microphone foreground service.
         FOREGROUND_SERVICE_MICROPHONE and the RECORD_AUDIO grant are both required before it can
         start on Android 14+. WAKE_LOCK keeps the CPU awake for capture; it is optional at run
         time (the wake_lock intent extra). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- This app declares no NPU manifest entries of its own: the AAR
         merges `<uses-native-library android:name="libcdsprpc.so"
         android:required="false"/>` (see cera-ffi-android's manifest),
         exactly as for any third-party consumer. Skeletons are extracted
         from libcera_ffi.so at runtime by HexagonNpu.setup, and the vendor
         FastRPC client is visible to the linker. -->
    <application
        android:label="Cera NPU Probe"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Lets simpleperf profile the non-debuggable field build from the shell. -->
        <profileable android:shell="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AudioServiceActivity"
            android:label="Cera Audio"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AudioPipelineService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
